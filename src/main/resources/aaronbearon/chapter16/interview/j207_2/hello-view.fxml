<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="aaronbearon.chapter16.interview.j207_2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Enter name, or 0 to exit" />
   <TextField fx:id="txtName" onKeyTyped="#textChanged" />
   <Label text="Enter last 4 digits of phone" />
   <TextField fx:id="txtPhone" onKeyTyped="#textChanged" />
    <Button fx:id="btnSubmit" disable="true" onAction="#onSubmit" text="Submit" />

    <Label fx:id="lblUsers" text="0 users entered" />
</VBox>
