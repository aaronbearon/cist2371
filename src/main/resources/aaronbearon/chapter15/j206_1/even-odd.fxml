<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<!-- Aaron Blum Interview 6 fxml -->
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="aaronbearon.chapter15.j206_1.EvenOddController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Created with scene builder -->
    <Label text="Number:"/>
    <TextField fx:id="txtIn"/>
    <Label text="Result:"/>
    <TextField fx:id="txtOut"/>
    <Button onAction="#onButtonClick" text="Show result"/>
</VBox>

<!-- I changed the properties of the autogenerated nodes,
        and then created my own. All of that done was in Scene Builder. -->
